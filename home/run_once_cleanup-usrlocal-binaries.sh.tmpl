#!/bin/bash
# chezmoi:template:left-delimiter="{{" right-delimiter="}}"
# One-time cleanup of direct-binary installs from before kubectl, kind,
# kubectx/kubens, nvim, and Lima (Linux) moved to .chezmoiexternal.yaml.tmpl.
# Those binaries now live under ~/.local (no sudo, no /usr/local collisions
# with Homebrew or Docker Desktop) — this just removes the old copies so
# they don't shadow the new ones on PATH.
#
# Only removes what the old install scripts created, and only for packages
# that are still enabled (so a replacement exists under ~/.local):
#   - kubectl/kind and the Lima tarball's files: plain files. Homebrew (/usr/local is its prefix
#     on Intel Macs) and Docker Desktop install symlinks, which are skipped.
#   - kubectx/kubens/nvim and bash completions: symlinks, removed only when
#     they point at the old install location.
#
# sudo is only ever used non-interactively (-n) so `chezmoi update` never
# stops at a password prompt; anything that can't be removed is listed at
# the end for manual cleanup instead of failing the apply.

set -euo pipefail

FAILED_PATHS=()

remove_path() {
    local path="$1"
    if rm -rf "$path" 2>/dev/null || sudo -n rm -rf "$path" 2>/dev/null; then
        return 0
    fi
    FAILED_PATHS+=("$path")
}

remove_regular_file() {
    local path="$1"
    if [[ -f "$path" && ! -L "$path" ]]; then
        remove_path "$path"
    fi
}

remove_symlink_to() {
    local link="$1"
    local expected_target="$2"
    if [[ -L "$link" && "$(readlink "$link")" == "$expected_target" ]]; then
        remove_path "$link"
    fi
}

remove_directory() {
    local path="$1"
    if [[ -d "$path" && ! -L "$path" ]]; then
        remove_path "$path"
    fi
}

{{ if .packages.kubernetes -}}
remove_regular_file /usr/local/bin/kubectl
remove_regular_file /usr/local/bin/kind
remove_symlink_to /usr/local/bin/kubectx /opt/kubectx/kubectx
remove_symlink_to /usr/local/bin/kubens /opt/kubectx/kubens
remove_symlink_to /etc/bash_completion.d/kubectx /opt/kubectx/completion/kubectx.bash
remove_symlink_to /etc/bash_completion.d/kubens /opt/kubectx/completion/kubens.bash
remove_directory /opt/kubectx
{{-   if eq .chezmoi.os "linux" }}
# Generated by the old Linux script from its /usr/local/bin/kubectl; stale
# once that binary is gone.
remove_regular_file /etc/bash_completion.d/kubectl
{{-   end }}
{{- end }}

{{ if .packages.neovim -}}
remove_symlink_to /usr/local/bin/nvim "${HOME}/.local/nvim/bin/nvim"
{{- end }}

{{ if and .packages.lima (eq .chezmoi.os "linux") -}}
# The old script extracted the whole Lima tarball into /usr/local, so take
# everything it shipped, not just limactl. An unmatched man-page glob stays
# literal and fails remove_regular_file's -f check, so it's a no-op.
for lima_binary in limactl lima apptainer.lima docker.lima kubectl.lima nerdctl.lima podman.lima; do
    remove_regular_file "/usr/local/bin/${lima_binary}"
done
for lima_man_page in /usr/local/share/man/man1/lima.1 /usr/local/share/man/man1/limactl*.1; do
    remove_regular_file "$lima_man_page"
done
remove_directory /usr/local/share/lima
remove_directory /usr/local/share/doc/lima
{{- end }}

if (( ${#FAILED_PATHS[@]} )); then
    printf "Could not remove these old installs (passwordless sudo unavailable):\n"
    printf "  %s\n" "${FAILED_PATHS[@]}"
    printf "Remove them manually so they don't shadow ~/.local/bin:\n"
    printf "  sudo rm -rf %s\n" "${FAILED_PATHS[*]}"
fi
